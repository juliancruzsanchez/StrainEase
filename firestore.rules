rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function ailmentItemValid(item) {
      return item is string && item.size() > 0 && item.size() < 48;
    }

    function ailmentsValid(list) {
      return list is list
        && list.size() <= 16
        && (list.size() == 0 || ailmentItemValid(list[0]))
        && (list.size() < 2 || ailmentItemValid(list[1]))
        && (list.size() < 3 || ailmentItemValid(list[2]))
        && (list.size() < 4 || ailmentItemValid(list[3]))
        && (list.size() < 5 || ailmentItemValid(list[4]))
        && (list.size() < 6 || ailmentItemValid(list[5]))
        && (list.size() < 7 || ailmentItemValid(list[6]))
        && (list.size() < 8 || ailmentItemValid(list[7]))
        && (list.size() < 9 || ailmentItemValid(list[8]))
        && (list.size() < 10 || ailmentItemValid(list[9]))
        && (list.size() < 11 || ailmentItemValid(list[10]))
        && (list.size() < 12 || ailmentItemValid(list[11]))
        && (list.size() < 13 || ailmentItemValid(list[12]))
        && (list.size() < 14 || ailmentItemValid(list[13]))
        && (list.size() < 15 || ailmentItemValid(list[14]))
        && (list.size() < 16 || ailmentItemValid(list[15]));
    }

    // Private patient profile — currently just saved ailments.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['ailments', 'ailmentsUpdatedAt'])
        && ailmentsValid(request.resource.data.ailments)
        && request.resource.data.ailmentsUpdatedAt is number
        && request.resource.data.ailmentsUpdatedAt > 0;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['ailments', 'ailmentsUpdatedAt'])
        && ailmentsValid(request.resource.data.ailments)
        && request.resource.data.ailmentsUpdatedAt is number
        && request.resource.data.ailmentsUpdatedAt > 0;
      allow delete: if isOwner(uid);
    }

    // Saved strains + notes are private to each user.
    match /users/{uid}/savedStrains/{slug} {
      allow read, write: if isOwner(uid);
    }

    // Public notes are readable by everyone, written only by signed-in users.
    match /publicNotes/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.note is string
        && request.resource.data.note.size() < 2000;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // AI results written only by Cloud Functions (Admin SDK). Anyone may read
    // a result they have the id for — ids are unguessable UUIDs.
    match /researchResults/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid}/reliefLogs/{id} {
      allow read, delete: if isOwner(uid);
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.strainName is string
        && request.resource.data.strainName.size() < 80
        && request.resource.data.fit in ['too-strong', 'just-right', 'too-weak']
        && request.resource.data.relief is number
        && request.resource.data.relief >= 1
        && request.resource.data.relief <= 5
        && request.resource.data.createdAt is number
        && request.resource.data.createdAt > 0;
      allow update: if false;
    }

    // Private search history index for signed-in patients.
    match /users/{uid}/history/{id} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['kind', 'title', 'createdAt'])
        && request.resource.data.kind in ['find', 'compare']
        && request.resource.data.title is string
        && request.resource.data.title.size() < 200
        && request.resource.data.createdAt is number;
      allow update: if false;
    }
  }
}
