{
  "name": "functions",
  "version": "1.0.0",
  "private": true,
  "description": "StrainEase backend — Leafly strain data + MiniMax AI, exposed as auth-gated callable functions",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.7.3"
  }
}
